function toggleTopic(header) {
  const card = header.closest('.topic-card');
  card.classList.toggle('open');
}

function handleSearch(val) {
  const q = val.trim().toLowerCase();
  const cards = document.querySelectorAll('.topic-card');
  let visible = 0;
  cards.forEach(card => {
    const text = card.textContent.toLowerCase();
    if (!q || text.includes(q)) {
      card.classList.remove('hidden-by-search');
      if (q) { card.classList.add('open'); }
      visible++;
    } else {
      card.classList.add('hidden-by-search');
      card.classList.remove('open');
    }
  });
  const sc = document.getElementById('search-count');
  if (q) {
    sc.textContent = `${visible} section${visible !== 1 ? 's' : ''} match "${val}"`;
  } else {
    sc.textContent = '';
  }
}

// ==================== QUIZ ====================

let selectedTypes = new Set(['mc','tf','fib','match']);

function toggleType(btn) {
  const t = btn.dataset.type;
  if (selectedTypes.has(t) && selectedTypes.size > 1) {
    selectedTypes.delete(t);
    btn.classList.remove('selected');
  } else if (!selectedTypes.has(t)) {
    selectedTypes.add(t);
    btn.classList.add('selected');
  }
}

function shuffleArr(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function startQuiz() {
  let pool = allQuestions.filter(q => selectedTypes.has(q.type));
  if (!pool.length) { alert('Please select at least one question type.'); return; }
  quizActive = shuffleArr(pool);
  qIndex = 0; score = 0; correct = 0; wrong = 0;

  document.getElementById('quiz-start-screen').style.display = 'none';
  document.getElementById('quiz-active-screen').style.display = 'block';
  document.getElementById('quiz-results-screen').style.display = 'none';
  renderQuestion();
}

function renderQuestion() {
  const total = quizActive.length;
  const pct = (qIndex / total) * 100;
  document.getElementById('quiz-progress').style.width = pct + '%';
  document.getElementById('quiz-counter').textContent = `Question ${qIndex + 1} of ${total}`;
  document.getElementById('quiz-score').textContent = `Score: ${score}`;
  document.getElementById('quiz-feedback').innerHTML = '';
  document.getElementById('quiz-next-btn').style.display = 'none';

  const q = quizActive[qIndex];
  const area = document.getElementById('quiz-question-area');

  if (q.type === 'mc') renderMC(q, area);
  else if (q.type === 'tf') renderTF(q, area);
  else if (q.type === 'fib') renderFIB(q, area);
  else if (q.type === 'match') renderMatch(q, area);
}

function renderMC(q, area) {
  const letters = ['A','B','C','D'];
  let opts = '';
  q.opts.forEach((opt, i) => {
    opts += `<button class="option-btn" onclick="answerMC(this, ${i}, ${q.ans})">
      <span class="opt-letter">${letters[i]}</span>${opt}
    </button>`;
  });
  area.innerHTML = `
    <div class="question-card">
      <div class="q-type-label">⬡ Multiple Choice</div>
      <div class="q-text">${q.q}</div>
      <div class="options-grid">${opts}</div>
    </div>`;
}

function answerMC(btn, chosen, correct) {
  const btns = btn.closest('.options-grid').querySelectorAll('.option-btn');
  btns.forEach((b, i) => {
    b.disabled = true;
    if (i === correct) b.classList.add('correct');
    else if (i === chosen) b.classList.add('wrong');
  });
  const isCorrect = chosen === correct;
  if (isCorrect) { score++; correct++; } else wrong++;
  showFeedback(isCorrect, quizActive[qIndex].exp);
  document.getElementById('quiz-score').textContent = `Score: ${score}`;
  document.getElementById('quiz-next-btn').style.display = 'inline-block';
  if (isCorrect) correct_count++; else wrong_count++;
}

let correct_count = 0, wrong_count = 0;

function renderTF(q, area) {
  area.innerHTML = `
    <div class="question-card">
      <div class="q-type-label">⬡ True or False</div>
      <div class="q-text">${q.q}</div>
      <div class="tf-grid">
        <button class="tf-btn" onclick="answerTF(this, true, ${q.ans})">✓ True</button>
        <button class="tf-btn" onclick="answerTF(this, false, ${q.ans})">✗ False</button>
      </div>
    </div>`;
}

function answerTF(btn, chosen, correctAns) {
  const btns = btn.closest('.tf-grid').querySelectorAll('.tf-btn');
  btns.forEach(b => { b.disabled = true; });
  const isCorrect = chosen === correctAns;
  if (isCorrect) { score++; correct_count++; btn.classList.add('correct'); }
  else { wrong_count++; btn.classList.add('wrong'); btns.forEach(b => { if ((b.textContent.includes('True') && correctAns) || (b.textContent.includes('False') && !correctAns)) b.classList.add('correct'); }); }
  document.getElementById('quiz-score').textContent = `Score: ${score}`;
  showFeedback(isCorrect, quizActive[qIndex].exp);
  document.getElementById('quiz-next-btn').style.display = 'inline-block';
}

function renderFIB(q, area) {
  area.innerHTML = `
    <div class="question-card">
      <div class="q-type-label">⬡ Fill in the Blank</div>
      <div class="q-text">${q.q}</div>
      <div class="fib-wrap">
        <input class="fib-input" id="fib-ans" type="text" placeholder="Type your answer…" onkeydown="if(event.key==='Enter')submitFIB()">
        <button class="btn-primary" onclick="submitFIB()" style="padding:12px 20px;">Check</button>
      </div>
      <div class="fib-hint">Hint: ${q.hint}</div>
    </div>`;
  setTimeout(() => document.getElementById('fib-ans').focus(), 100);
}

function submitFIB() {
  const input = document.getElementById('fib-ans');
  if (!input) return;
  const q = quizActive[qIndex];
  const userAns = input.value.trim().toLowerCase().replace(/\s+/g,' ');
  const correctAns = q.ans.toLowerCase().replace(/\s+/g,' ');
  const isCorrect = userAns === correctAns || correctAns.includes(userAns) && userAns.length > 3;
  input.disabled = true;
  input.classList.add(isCorrect ? 'correct' : 'wrong');
  if (isCorrect) { score++; correct_count++; }
  else { wrong_count++; input.value = input.value + ' → ' + q.ans; }
  document.getElementById('quiz-score').textContent = `Score: ${score}`;
  showFeedback(isCorrect, q.exp);
  document.getElementById('quiz-next-btn').style.display = 'inline-block';
  const checkBtn = input.nextElementSibling;
  if (checkBtn) checkBtn.disabled = true;
}

function renderMatch(q, area) {
  matchSelected = null;
  const pairs = shuffleArr(q.pairs);
  const rights = shuffleArr(pairs.map(p => p.right));
  const lefts = pairs.map(p => p.left);
  matchCorrect = 0; matchTotal = pairs.length;

  const leftHtml = lefts.map((l,i) => `<div class="match-item" data-side="left" data-idx="${i}" data-val="${l}" onclick="selectMatch(this)">${l}</div>`).join('');
  const rightHtml = rights.map((r,i) => `<div class="match-item" data-side="right" data-idx="${i}" data-val="${r}" onclick="selectMatch(this)">${r}</div>`).join('');

  area.innerHTML = `
    <div class="question-card">
      <div class="q-type-label">⬡ Matching</div>
      <div class="q-text">${q.instruction}</div>
      <div class="match-container">
        <div class="match-col">
          <div class="match-col-label">Column A</div>
          ${leftHtml}
        </div>
        <div class="match-col">
          <div class="match-col-label">Column B</div>
          ${rightHtml}
        </div>
      </div>
    </div>`;

  // Store pairs mapping for answer checking
  area.dataset.pairs = JSON.stringify(pairs);
}

function selectMatch(item) {
  if (item.classList.contains('matched-correct') || item.classList.contains('matched-wrong')) return;

  if (!matchSelected) {
    // First click — must be left side
    if (item.dataset.side !== 'left') return;
    matchSelected = item;
    item.classList.add('selected');
  } else {
    // Second click — must be right side
    if (item.dataset.side !== 'right') {
      matchSelected.classList.remove('selected');
      matchSelected = null;
      return;
    }
    const leftVal = matchSelected.dataset.val;
    const rightVal = item.dataset.val;
    const area = document.getElementById('quiz-question-area');
    const pairs = JSON.parse(area.dataset.pairs);
    const correct = pairs.find(p => p.left === leftVal && p.right === rightVal);
    matchSelected.classList.remove('selected');
    if (correct) {
      matchSelected.classList.add('matched-correct');
      item.classList.add('matched-correct');
      matchCorrect++;
      if (matchCorrect === matchTotal) {
        score += matchTotal; correct_count += matchTotal;
        document.getElementById('quiz-score').textContent = `Score: ${score}`;
        showFeedback(true, `All ${matchTotal} pairs matched correctly! Great work!`);
        document.getElementById('quiz-next-btn').style.display = 'inline-block';
      }
    } else {
      matchSelected.classList.add('matched-wrong');
      item.classList.add('matched-wrong');
      wrong_count++;
      setTimeout(() => {
        matchSelected && matchSelected.classList.remove('matched-wrong');
        item.classList.remove('matched-wrong');
        matchSelected = null;
      }, 900);
    }
    matchSelected = null;
  }
}

function showFeedback(isCorrect, explanation) {
  const fb = document.getElementById('quiz-feedback');
  fb.innerHTML = `<div class="feedback-box ${isCorrect ? 'correct' : 'wrong'}">
    <strong>${isCorrect ? '✓ Correct!' : '✗ Incorrect'}</strong>
    ${explanation}
  </div>`;
}

function nextQuestion() {
  qIndex++;
  if (qIndex >= quizActive.length) {
    showResults();
  } else {
    renderQuestion();
  }
}

function showResults() {
  document.getElementById('quiz-active-screen').style.display = 'none';
  document.getElementById('quiz-results-screen').style.display = 'block';
  const total = quizActive.length;
  const pct = Math.round((score / (total + matchTotal - 1)) * 100);
  const safePct = Math.min(100, Math.max(0, Math.round((correct_count / (correct_count + wrong_count || 1)) * 100)));
  document.getElementById('res-pct').textContent = safePct + '%';
  document.getElementById('res-correct').textContent = correct_count;
  document.getElementById('res-wrong').textContent = wrong_count;
  document.getElementById('res-total').textContent = quizActive.length;
  const remarks = [
    [90, "Outstanding! You clearly know your RPH! 🏆"],
    [75, "Great job! Just a few topics to review. 📚"],
    [60, "Good effort! Focus on the dates and constitutions. 💪"],
    [0, "Keep studying! Go through the Reviewer mode again. 📖"],
  ];
  const remark = remarks.find(r => safePct >= r[0]);
  document.getElementById('res-remark').textContent = remark[1];
}

function resetQuiz() {
  correct_count = 0; wrong_count = 0; score = 0; qIndex = 0;
  document.getElementById('quiz-active-screen').style.display = 'none';
  document.getElementById('quiz-results-screen').style.display = 'none';
  document.getElementById('quiz-start-screen').style.display = 'block';
  document.getElementById('quiz-progress').style.width = '0%';
}

// ==================== FLASHCARDS ====================

function getFilteredCards() {
  if (fcFilter === 'all') return allFlashcards;
  if (fcFilter === 'know') return allFlashcards.filter((_, i) => knownSet.has(i));
  if (fcFilter === 'review') return allFlashcards.filter((_, i) => reviewSet.has(i));
  return allFlashcards.filter(c => c.category === fcFilter);
}

function updateFcStats() {
  document.getElementById('fc-stat-total').textContent = allFlashcards.length;
  document.getElementById('fc-stat-know').textContent = knownSet.size;
  document.getElementById('fc-stat-review').textContent = reviewSet.size;
}

function renderFC() {
  const cards = getFilteredCards();
  const empty = document.getElementById('fc-empty');
  const scene = document.getElementById('fc-scene');

  if (!cards.length) {
    scene.style.display = 'none';
    empty.style.display = 'block';
    document.getElementById('fc-pos').textContent = '0';
    document.getElementById('fc-total').textContent = '0';
    document.getElementById('fc-status').innerHTML = '';
    return;
  }

  scene.style.display = 'block';
  empty.style.display = 'none';

  // Clamp index
  if (fcIndex >= cards.length) fcIndex = cards.length - 1;
  if (fcIndex < 0) fcIndex = 0;

  const card = cards[fcIndex];
  const globalIndex = allFlashcards.indexOf(card);

  document.getElementById('fc-front-text').textContent = card.front;
  document.getElementById('fc-back-text').textContent = card.back;

  const catLabels = { term: 'KEY TERM', person: 'PERSON', date: 'DATE' };
  const catLabel = catLabels[card.category] || 'CARD';
  document.getElementById('fc-cat-tag').textContent = catLabel;
  document.getElementById('fc-cat-tag-back').textContent = catLabel;

  document.getElementById('fc-pos').textContent = fcIndex + 1;
  document.getElementById('fc-total').textContent = cards.length;

  // Unflip card
  document.getElementById('fc-card').classList.remove('flipped');

  // Status
  const statusEl = document.getElementById('fc-status');
  if (knownSet.has(globalIndex)) {
    statusEl.innerHTML = '<span class="status-know">✓ Marked as Know It</span>';
  } else if (reviewSet.has(globalIndex)) {
    statusEl.innerHTML = '<span class="status-review">↺ Marked for Review Again</span>';
  } else {
    statusEl.innerHTML = '';
  }

  // Nav buttons
  document.getElementById('fc-prev-btn').disabled = fcIndex === 0;
  document.getElementById('fc-next-btn').disabled = fcIndex === cards.length - 1;

  updateFcStats();
}

function flipCard() {
  document.getElementById('fc-card').classList.toggle('flipped');
}

function fcNavigate(dir) {
  fcIndex += dir;
  renderFC();
}

function markCard(type) {
  const cards = getFilteredCards();
  if (!cards.length) return;
  const card = cards[fcIndex];
  const globalIndex = allFlashcards.indexOf(card);

  if (type === 'know') {
    knownSet.add(globalIndex);
    reviewSet.delete(globalIndex);
  } else {
    reviewSet.add(globalIndex);
    knownSet.delete(globalIndex);
  }

  // Auto advance
  if (fcIndex < cards.length - 1) {
    fcIndex++;
    renderFC();
  } else {
    renderFC(); // Re-render to update status
  }
}

function setFcFilter(filter, btn) {
  fcFilter = filter;
  document.querySelectorAll('#fc-filter-btns .badge').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  fcIndex = 0;
  renderFC();
}

// ==================== MODE SWITCHING ====================

function switchMode(mode) {
  document.querySelectorAll('.mode').forEach(m => m.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('mode-' + mode).classList.add('active');
  event.target.classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ==================== INIT ====================

renderReviewer();
renderFC();
</script>
